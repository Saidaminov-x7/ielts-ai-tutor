{
  "name": "Application Health Monitoring",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */30 * * *"
            }
          ]
        }
      },
      "id": "health-schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://ielts-webhook.railway.internal:8080/health",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json",
              "includeResponseHeadersAndStatus": true
            }
          }
        }
      },
      "id": "health-request",
      "name": "Check IELTS health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "health-status",
      "name": "Is healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ielts-webhook.railway.internal:8080/internal/scheduled-event",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({event_type: 'application_health_monitoring', event_date: $now.setZone('Asia/Tashkent').toISODate()}) }}"
      },
      "id": "health-alert",
      "name": "Notify through IELTS Python service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        420
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Check IELTS health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check IELTS health": {
      "main": [
        [
          {
            "node": "Is healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is healthy?": {
      "main": [
        [],
        [
          {
            "node": "Notify through IELTS Python service",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tashkent",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none"
  },
  "versionId": "application-health-initial",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
