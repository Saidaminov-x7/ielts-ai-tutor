{
  "name": "Weekly IELTS Exam",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 0"
            }
          ]
        }
      },
      "id": "weekly_ielts_exam-schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ielts-webhook.railway.internal:8080/internal/scheduled-event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Daily-Job-Secret",
              "value": "={{ $env.DAILY_JOB_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({event_type: 'weekly_ielts_exam', event_date: $now.setZone('Asia/Tashkent').toISODate()}) }}"
      },
      "id": "weekly-ielts-exam",
      "name": "Call IELTS Python service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Call IELTS Python service",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tashkent",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none"
  },
  "versionId": "weekly_ielts_exam-initial",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
