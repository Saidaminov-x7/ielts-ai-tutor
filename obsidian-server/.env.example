# Use only in a local .env ignored by Git, or Railway Variables. Never commit
# real values. The Railway service in this separate project needs its own
# vault-scoped token; cross-project references to ielts-webhook do not resolve.
GITHUB_TOKEN=replace-with-private-vault-fine-grained-token
GITHUB_REPO=Saidaminov-x7/ielts-tutor-notes-vault
GITHUB_BRANCH=main

# OAuth2 Proxy secrets belong only in Railway Variables.
OAUTH2_PROXY_CLIENT_ID=replace-with-github-oauth-app-client-id
OAUTH2_PROXY_CLIENT_SECRET=replace-with-github-oauth-app-client-secret
OAUTH2_PROXY_COOKIE_SECRET=replace-with-base64-encoded-32-byte-secret
OAUTH2_PROXY_REDIRECT_URL=https://replace-with-railway-domain/oauth2/callback
