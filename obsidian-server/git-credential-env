#!/bin/sh
set -eu

case "${1:-}" in
  get)
    if [ -z "${GITHUB_TOKEN:-}" ]; then
      exit 1
    fi
    printf 'username=x-access-token\npassword=%s\n\n' "$GITHUB_TOKEN"
    ;;
  store|erase)
    # Credentials are supplied from the process environment and never persisted.
    cat >/dev/null
    ;;
  *)
    exit 0
    ;;
esac
